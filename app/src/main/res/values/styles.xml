<resources>

    <!-- Base application theme - Material 3 for MaterialDrawer 9.x -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="cardViewStyle">@style/CardView.Light</item>
        <item name="materialCardViewStyle">@style/CardView.Light</item>
    </style>

    <style name="AppTheme.Start" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/pic_start</item>
        <item name="android:windowActionBarOverlay">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar.TransparentStatusBar" parent="AppTheme.NoActionBar" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="SpinnerStyle" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:spinnerItemStyle">@android:color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
